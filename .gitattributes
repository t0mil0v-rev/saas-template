# Репозиторий редактируется на разных ОС, а shell-файлы запускаются на Linux.
* text=auto eol=lf

# Бинарные файлы не проходят нормализацию строк.
*.png binary
*.jpg binary
*.webp binary
*.woff binary
*.woff2 binary
*.dump binary
*.age binary

*.sh text eol=lf
*.caddy text eol=lf
Caddyfile text eol=lf
*.Caddyfile text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.service text eol=lf
*.timer text eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
