#  SaaS Template - конфигурация окружения
#  Скопируйте в .env и заполните. В production приложение не запустится,
#  если оставлены значения-заглушки (CHANGE_ME) или слабые секреты.
#
#      cp .env.example .env && ./deploy/scripts/gen-secrets.sh
#
#  Файл .env должен иметь права 0600 и не попадать в git.

# 1. Базовое
APP_NAME="Acme Platform"
# development | staging | production
APP_ENV=production
# Публичный адрес, по которому браузер открывает приложение.
# Используется для CORS, cookie domain, ссылок в письмах и CSP.
PUBLIC_URL=https://app.example.com
# Домен(ы) для Caddy. Несколько - через пробел.
DOMAIN=app.example.com

# 2. TLS в вашей инфраструктуре
#   acme     - Caddy сам получает и продлевает сертификат Let's Encrypt.
#              Требует: публичный DNS на этот сервер + открытые 80/443 наружу.
#   internal - свой сертификат (корпоративный CA / wildcard).
#              Положите файлы в deploy/certs/  →  tls.crt и tls.key
#   none     - HTTPS терминируется выше (корпоративный балансировщик, WAF).
#              Caddy слушает обычный HTTP на PROXY_HTTP_PORT.
TLS_MODE=acme
# Почта для ACME-аккаунта (нужна только при TLS_MODE=acme)
ACME_EMAIL=ops@example.com
# Свой ACME-сервер (внутренний step-ca / smallstep). Пусто = Let's Encrypt.
ACME_CA=

# Порты, которые Caddy публикует на хосте
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# 3. Секреты  -  сгенерируйте: openssl rand -base64 48
# Главный ключ. Из него выводятся ключи подписи cookie, CSRF и шифрования TOTP.
SECRET_KEY=CHANGE_ME
# Старые SECRET_KEY через запятую. Оставьте пустым, если ротации не было.
SECRET_KEY_PREVIOUS=
# Пароль пользователя БД
POSTGRES_PASSWORD=CHANGE_ME
# Пароль Redis (Redis не должен быть доступен без пароля даже внутри docker-сети)
REDIS_PASSWORD=CHANGE_ME

# 4. База данных
POSTGRES_USER=saas
POSTGRES_DB=saas
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Пул соединений на ОДИН воркер. Итог: DB_POOL_SIZE * API_WORKERS ≤ max_connections
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=15000
# disable | prefer | require | verify-ca | verify-full
DB_SSLMODE=prefer

# 5. Redis  -  rate limit, кэш, счётчики. Необязателен.
# Пусто = приложение работает без Redis (лимиты считаются в памяти процесса).
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0

# 6. Сетевой стек API
API_HOST=0.0.0.0
API_PORT=8000
# 0 = auto (по числу CPU, максимум 8). Каждый воркер - отдельный процесс.
API_WORKERS=0
# Максимальный размер тела запроса, байт (1 МиБ)
MAX_REQUEST_BODY_BYTES=1048576
# Таймаут обработки одного запроса, сек. Превышение → 503 и запись в лог.
REQUEST_TIMEOUT_S=30
# Keep-alive и graceful shutdown, сек
KEEPALIVE_TIMEOUT_S=15
GRACEFUL_SHUTDOWN_S=25
# Размер очереди принятых соединений
LISTEN_BACKLOG=2048
# Перезапуск воркера после N запросов (защита от утечек памяти). 0 = выключено.
MAX_REQUESTS_PER_WORKER=0

# Доверенные прокси
# Список определяет, кому можно верить в X-Forwarded-For.
# Если оставить пусто - заголовки Forwarded игнорируются полностью и реальным
# IP считается адрес TCP-соединения (правильно при прямом доступе к API).
# Docker-сеть по умолчанию: 172.16.0.0/12. Локальный Caddy: 127.0.0.1/32.
TRUSTED_PROXIES=172.16.0.0/12,127.0.0.1/32
# Сколько прокси стоит перед приложением. Реальный IP берётся как
# (depth+1)-й справа элемент X-Forwarded-For - подделать его нельзя.
TRUSTED_PROXY_DEPTH=1

# 7. Сессии и аутентификация
SESSION_COOKIE_NAME=__Host-sid
# Абсолютное время жизни сессии, часов
SESSION_ABSOLUTE_TTL_H=720
# Простой без активности, часов
SESSION_IDLE_TTL_H=72
# Максимум одновременных сессий на пользователя (старые вытесняются)
SESSION_MAX_PER_USER=10
# Требовать подтверждения e-mail перед входом
REQUIRE_EMAIL_VERIFICATION=true
# Разрешена ли публичная регистрация. false = только по приглашениям.
ALLOW_PUBLIC_SIGNUP=true
# Блокировка после серии неудачных попыток
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_MINUTES=15
# Минимальная длина пароля (в символах). Проверяется также по списку утечек.
PASSWORD_MIN_LENGTH=12

# 8. Ограничение частоты запросов (token bucket)
RATE_LIMIT_ENABLED=true
# Глобально на IP: запросов в минуту
RATE_LIMIT_GLOBAL_PER_MIN=300
# На эндпоинты входа/регистрации/сброса пароля: запросов в минуту на IP
RATE_LIMIT_AUTH_PER_MIN=10
# На публичную отправку отзыва: в час на IP
RATE_LIMIT_REVIEW_PER_HOUR=5

# 9. Почта  -  подтверждение e-mail, сброс пароля, приглашения
# smtp | console  (console = письма печатаются в лог, для разработки)
MAIL_TRANSPORT=console
MAIL_FROM="Acme Platform <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# starttls | ssl | none
SMTP_SECURITY=starttls
SMTP_TIMEOUT_S=10
# Retry worker: polling, lease после падения процесса и число попыток.
MAIL_OUTBOX_POLL_S=1
MAIL_OUTBOX_LEASE_S=300
MAIL_OUTBOX_MAX_ATTEMPTS=8
MAIL_OUTBOX_RETENTION_DAYS=7

# 10. Наблюдаемость
# debug | info | warning | error
LOG_LEVEL=info
# json | console
LOG_FORMAT=json
# Prometheus-метрики на /metrics. Доступ только из этих сетей.
METRICS_ENABLED=true
METRICS_ALLOWED_NETS=172.16.0.0/12,127.0.0.1/32
# Открывать /docs и /openapi.json. В production по умолчанию выключено.
ENABLE_API_DOCS=false
# Сроки хранения служебных данных.
AUDIT_RETENTION_DAYS=365
SESSION_RETENTION_DAYS=7
INVITATION_RETENTION_DAYS=30

# 11. Первичный администратор  -  создаётся один раз при первом запуске
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
# Организация-владелец публичного лендинга
BOOTSTRAP_ORG_NAME="Acme"
BOOTSTRAP_ORG_SLUG=acme

# 12. Резервное копирование
BACKUP_DIR=/var/backups/saas
BACKUP_RETENTION_DAYS=14
# Публичный ключ age для шифрования дампов (age1...). Пусто = без шифрования.
BACKUP_AGE_RECIPIENT=
# Приватный ключ нужен только оператору restore.sh и не должен храниться в репозитории.
BACKUP_AGE_IDENTITY=
