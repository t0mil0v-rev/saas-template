# TLS_MODE=none  -  HTTPS терминируется выше (корпоративный балансировщик, WAF).
#
# Caddy слушает обычный HTTP на :80 внутри контейнера и не занимается
# сертификатами. Внешний балансировщик обязан:
#   * терминировать TLS и добавлять заголовки X-Forwarded-For / X-Forwarded-Proto;
#   * его адрес должен входить в TRUSTED_PROXIES приложения, иначе реальный IP
#     клиента определить не удастся (см. app/net/proxy.py).
#
# ВНИМАНИЕ: не публикуйте этот режим напрямую в интернет без TLS впереди.
{
	admin localhost:2019
	auto_https off
}

import /etc/caddy/common.caddy

# :80 - принимаем любой Host: за нами уже стоит балансировщик, который
# отвечает за маршрутизацию доменов.
:80 {
	import app_site
}
